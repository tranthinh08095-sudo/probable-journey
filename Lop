-- Steal Logic
local function DoSteal()
    local lp = game.Players.LocalPlayer
    local char = lp.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return end

    local oldPos = char.HumanoidRootPart.CFrame

    for _, target in pairs(game.Players:GetPlayers()) do
        if target ~= lp and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            -- Teleport to target outside safezone
            char.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            task.wait(0.2)
            
            -- Trigger Tool or Remote
            local tool = lp.Backpack:FindFirstChildOfClass("Tool") or char:FindFirstChildOfClass("Tool")
            if tool then
                tool.Parent = char
                tool:Activate()
            end
            
            local stealRemote = game:GetService("ReplicatedStorage"):FindFirstChild("StealEgg", true) 
                or game:GetService("ReplicatedStorage"):FindFirstChild("Steal", true)
            if stealRemote then
                stealRemote:FireServer(target)
            end
            
            task.wait(0.3)
            -- Return to original position
            char.HumanoidRootPart.CFrame = oldPos
            break
        end
    end
end

-- Teleport Button Action
TeleBtn.MouseButton1Click:Connect(function()
    DoSteal()
end)

-- Loop Button Action
local IsLooping = false
LoopBtn.MouseButton1Click:Connect(function()
    IsLooping = not IsLooping
    if IsLooping then
        LoopBtn.Text = "LOOP: ON"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        LoopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        task.spawn(function()
            while IsLooping do
                DoSteal()
                task.wait(1.5)
            end
        end)
    else
        LoopBtn.Text = "LOOP: OFF"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        LoopBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)
