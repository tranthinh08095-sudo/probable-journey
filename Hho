-- Logic tìm Ổ Trứng & Pet ngon nhất
local function FindBestTarget()
    local targetEgg = nil
    local targetPlayer = nil
    local bestName = "No Pet Found"

    -- Tìm trong Workspace (Plots / Eggs)
    local plots = workspace:FindFirstChild("Plots") or workspace:FindFirstChild("Bases") or workspace
    for _, obj in pairs(plots:GetDescendants()) do
        if obj.Name:lower():find("egg") or obj.Name:lower():find("nest") or obj:FindFirstChild("Pet") then
            -- Kiểm tra xem ổ này có phải của người chơi khác không
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and (obj:IsDescendantOf(plr.Character) or tostring(obj.Parent):find(plr.Name)) then
                    targetEgg = obj
                    targetPlayer = plr
                    bestName = obj.Name
                    break
                end
            end
        end
    end

    if not targetPlayer then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                targetPlayer = plr
                targetEgg = plr.Character.HumanoidRootPart
                bestName = "Player Egg (" .. plr.DisplayName .. ")"
                break
            end
        end
    end

    return targetEgg, targetPlayer, bestName
end

-- Cập nhật thông tin Pet
task.spawn(function()
    while task.wait(3) do
        local _, _, name = FindBestTarget()
        PetText.Text = "BEST PET: " .. name
    end
end)

-- Logic Cướp Trứng
local function ExecuteSteal()
    local char = LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return end

    local eggObj, targetPlr, _ = FindBestTarget()
    if not targetPlr then return end

    local oldCFrame = char.HumanoidRootPart.CFrame

    -- 1. Teleport thẳng tới ổ trứng
    if eggObj and eggObj:IsA("BasePart") then
        char.HumanoidRootPart.CFrame = eggObj.CFrame * CFrame.new(0, 2, 2)
    elseif targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 2, 2)
    end

    task.wait(0.2)

    -- 2. Kích hoạt Remote Cướp Trứng
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:lower():find("steal") or v.Name:lower():find("egg")) then
            v:FireServer(targetPlr)
            v:FireServer(eggObj)
        end
    end

    -- 3. Cầm Tool cướp nếu có
    local tool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool") or char:FindFirstChildOfClass("Tool")
    if tool then
        tool.Parent = char
        tool:Activate()
    end

    task.wait(0.3)

    -- 4. Quay về ổ trứng nhà mình
    char.HumanoidRootPart.CFrame = oldCFrame
end

-- Sự kiện bấm nút
TeleBtn.MouseButton1Click:Connect(function()
    ExecuteSteal()
end)

local IsLooping = false
LoopBtn.MouseButton1Click:Connect(function()
    IsLooping = not IsLooping
    if IsLooping then
        LoopBtn.Text = "LOOP: ON"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        LoopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

        task.spawn(function()
            while IsLooping do
                ExecuteSteal()
                task.wait(1.2)
            end
        end)
    else
        LoopBtn.Text = "LOOP: OFF"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        LoopBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)
