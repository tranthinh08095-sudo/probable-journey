-- [[ Nai Hub - Blox Fruits ]] --

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Nai Hub : Blox Fruits",
    SubTitle = "by Nai",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Discord = Window:AddTab({ Title = "Discord", Icon = "disc" }),
    Server = Window:AddTab({ Title = "Server", Icon = "server" }),
    Shop = Window:AddTab({ Title = "Shop", Icon = "shopping-bag" }),
    Farm = Window:AddTab({ Title = "Farm", Icon = "swords" }),
    HopFarm = Window:AddTab({ Title = "Hop Farm", Icon = "repeat" }),
    StackFarming = Window:AddTab({ Title = "Stack Farming", Icon = "layers" }),
    PVP = Window:AddTab({ Title = "PVP", Icon = "crosshair" }),
    Fishing = Window:AddTab({ Title = "Fishing/Slap Fish", Icon = "fish" }),
    Esp = Window:AddTab({ Title = "Esp", Icon = "eye" })
}

local Options = Fluent.Options

do
    Tabs.Farm:AddSection("Select tool")

    local WeaponDropdown = Tabs.Farm:AddDropdown("ChooseWeapon", {
        Title = "Choose Weapon",
        Values = {"Melee", "Sword", "Blox Fruit"},
        Multi = false,
        Default = 1,
    })

    Tabs.Farm:AddSlider("FarmHeight", {
        Title = "Farm Distance (Melee/Sword)",
        Default = 40,
        Min = 0,
        Max = 100,
        Rounding = 0,
        Callback = function(Value)
        end
    })

    Tabs.Farm:AddSection("Farm")

    Tabs.Farm:AddParagraph({
        Title = "Cake Prince",
        Content = "Remaining: 0 / 500"
    })

    Tabs.Farm:AddParagraph({
        Title = "Bones",
        Content = "Bones: 0"
    })

    local FarmTargetDropdown = Tabs.Farm:AddDropdown("FarmTarget", {
        Title = "Choose Farm Target",
        Values = {"Auto Level", "Auto Bone", "Auto Cake Prince", "Auto Dough King"},
        Multi = false,
        Default = 1,
    })

    Tabs.Farm:AddToggle("AutoFarmToggle", {
        Title = "Auto Farm Level",
        Default = false,
        Callback = function(Value)
            _G.AutoFarm = Value
        end
    })
end

Fluent:Notify({
    Title = "Nai Hub",
    Content = "Script loaded successfully!",
    Duration = 5
})
