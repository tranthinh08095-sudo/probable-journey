local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "LENNON HUB - Steal An Egg",
    SubTitle = "",
    TabWidth = 140,
    Size = UDim2.fromOffset(450, 280),
    Acrylic = false,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "" })
}

local Section = Tabs.Main:AddSection("Auto Steal")

local AutoLoop = false

-- Lấy Pet xịn nhất server
local function GetBestPetInfo()
    local bestPetName = "Không thấy Pet"
    local bestPlayer = nil
    
    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= game.Players.LocalPlayer then
            local container = player:FindFirstChild("Backpack") or player:FindFirstChild("Pets")
            if container then
                for _, item in pairs(container:GetChildren()) do
                    bestPetName = item.Name
                    bestPlayer = player
                    break
                end
            end
        end
    end
    return bestPetName, bestPlayer
end

local petName, targetPlayer = GetBestPetInfo()

-- UI hiển thị Pet ngon nhất
local PetParagraph = Section:AddParagraph({
    Title = "PET VIP:",
    Content = petName
})

-- Nút TELEPORT (Nhảy tới ổ lấy trứng & cướp)
Section:AddButton({
    Title = "TELEPORT (Cướp 1 lần)",
    Callback = function()
        local lp = game.Players.LocalPlayer
        local char = lp.Character
        _, targetPlayer = GetBestPetInfo()
        
        if char and char:FindFirstChild("HumanoidRootPart") and targetPlayer and targetPlayer.Character then
            -- 1. Teleport sang ổ nhà người chơi có pet ngon
            char.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            task.wait(0.3)
            
            -- 2. Gọi Remote Cướp
            local stealRemote = game:GetService("ReplicatedStorage"):FindFirstChild("StealEgg", true) 
                or game:GetService("ReplicatedStorage"):FindFirstChild("Steal", true)
            if stealRemote then
                stealRemote:FireServer(targetPlayer)
            end
            
            task.wait(0.3)
            -- 3. Teleport về căn cứ của mình
            if lp:FindFirstChild("SpawnPoint") then
                char.HumanoidRootPart.CFrame = lp.SpawnPoint.CFrame
            end
        end
    end
})

-- Toggle LOOP (Tự động cướp liên tục)
Section:AddToggle("LoopSteal", {
    Title = "LOOP (Cướp liên tục)",
    Default = false,
    Callback = function(Value)
        AutoLoop = Value
        if AutoLoop then
            task.spawn(function()
                while AutoLoop do
                    local lp = game.Players.LocalPlayer
                    local char = lp.Character
                    _, targetPlayer = GetBestPetInfo()
                    
                    if char and char:FindFirstChild("HumanoidRootPart") and targetPlayer and targetPlayer.Character then
                        char.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        task.wait(0.3)
                        
                        local stealRemote = game:GetService("ReplicatedStorage"):FindFirstChild("StealEgg", true) 
                            or game:GetService("ReplicatedStorage"):FindFirstChild("Steal", true)
                        if stealRemote then
                            stealRemote:FireServer(targetPlayer)
                        end
                        
                        task.wait(0.3)
                        if lp:FindFirstChild("SpawnPoint") then
                            char.HumanoidRootPart.CFrame = lp.SpawnPoint.CFrame
                        end
                    end
                    task.wait(1)
                end
            end)
        end
    end
})

Window:SelectTab(1)
